{
  "name": "halomusic",
  "version": "1.1.0",
  "private": true,
  "description": "HaloMusic —— 基于 Electron + Vue 3 + TypeScript 的网易云音乐第三方桌面客户端",
  "author": "zorroe <1318753541@qq.com>",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "keywords": [
    "electron",
    "vite",
    "vue3",
    "typescript",
    "music",
    "netease-cloud-music"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.9.0",
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder --config electron-builder.json5",
    "build:dist": "vite build && electron-builder --config electron-builder.json5",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@icon-park/vue-next": "^1.4.2",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "express": "^4.22.3",
    "express-http-proxy": "^2.1.1",
    "js-cookie": "^3.0.8",
    "NeteaseCloudMusicApi": "^4.34.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5",
    "vue-slider-component": "^4.1.0-beta.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^4.17.21",
    "@types/express-http-proxy": "^1.6.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "daisyui": "^5.8.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.0.0",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.6",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.12"
  }
}
